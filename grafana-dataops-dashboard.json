{
  "dashboard": {
    "id": null,
    "uid": "data-operations",
    "title": "Data Operations",
    "tags": ["database", "postgresql", "pgbouncer", "operations"],
    "timezone": "browser",
    "refresh": "10s",
    "time": { "from": "now-1h", "to": "now" },
    "panels": [
      {
        "id": 1, "title": "PostgreSQL Up", "type": "stat",
        "gridPos": { "h": 3, "w": 3, "x": 0, "y": 0 },
        "targets": [{ "expr": "pg_up", "refId": "A" }],
        "fieldConfig": { "defaults": {
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }]
        }}
      },
      {
        "id": 2, "title": "PgBouncer Up", "type": "stat",
        "gridPos": { "h": 3, "w": 3, "x": 3, "y": 0 },
        "targets": [{ "expr": "pgbouncer_up", "refId": "A" }],
        "fieldConfig": { "defaults": {
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }]
        }}
      },
      {
        "id": 3, "title": "Total Connections", "type": "stat",
        "gridPos": { "h": 3, "w": 3, "x": 6, "y": 0 },
        "targets": [{ "expr": "pg_total_connections", "legendFormat": "Total", "refId": "A" }],
        "fieldConfig": { "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 20 }, { "color": "red", "value": 28 }] }
        }}
      },
      {
        "id": 4, "title": "Database Size", "type": "stat",
        "gridPos": { "h": 3, "w": 3, "x": 9, "y": 0 },
        "targets": [{ "expr": "pg_database_size_bytes", "refId": "A" }],
        "fieldConfig": { "defaults": { "unit": "decbytes" }}
      },
      {
        "id": 5, "title": "Client Utilization", "type": "gauge",
        "gridPos": { "h": 3, "w": 3, "x": 12, "y": 0 },
        "targets": [{ "expr": "pgbouncer_client_utilization_percent", "refId": "A" }],
        "fieldConfig": { "defaults": {
          "min": 0, "max": 100, "unit": "percent",
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 80 }] }
        }}
      },
      {
        "id": 6, "title": "Server Utilization", "type": "gauge",
        "gridPos": { "h": 3, "w": 3, "x": 15, "y": 0 },
        "targets": [{ "expr": "pgbouncer_server_utilization_percent", "refId": "A" }],
        "fieldConfig": { "defaults": {
          "min": 0, "max": 100, "unit": "percent",
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 60 }, { "color": "red", "value": 90 }] }
        }}
      },
      {
        "id": 7, "title": "Waiting Clients", "type": "stat",
        "gridPos": { "h": 3, "w": 3, "x": 18, "y": 0 },
        "targets": [{ "expr": "sum(pgbouncer_client_waiting{database!=\"pgbouncer\"})", "refId": "A" }],
        "fieldConfig": { "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 3 }, { "color": "red", "value": 10 }] }
        }}
      },
      {
        "id": 8, "title": "Avg Query Time", "type": "stat",
        "gridPos": { "h": 3, "w": 3, "x": 21, "y": 0 },
        "targets": [{ "expr": "pgbouncer_avg_query_time_ms{database!=\"pgbouncer\"}", "refId": "A" }],
        "fieldConfig": { "defaults": {
          "unit": "ms",
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 2000 }] }
        }}
      },
      {
        "id": 10, "title": "Connection States", "type": "piechart",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 3 },
        "targets": [{ "expr": "pg_connections_by_state{state!=\"\"}", "legendFormat": "{{state}}", "refId": "A" }]
      },
      {
        "id": 11, "title": "PgBouncer Pool Status", "type": "bargauge",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 3 },
        "targets": [
          { "expr": "sum(pgbouncer_server_active{database!=\"pgbouncer\"})", "legendFormat": "Active", "refId": "A" },
          { "expr": "sum(pgbouncer_server_idle{database!=\"pgbouncer\"})", "legendFormat": "Idle", "refId": "B" },
          { "expr": "sum(pgbouncer_server_used{database!=\"pgbouncer\"})", "legendFormat": "Used", "refId": "C" }
        ],
        "fieldConfig": { "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 20 }, { "color": "red", "value": 28 }] }
        }},
        "options": { "orientation": "horizontal", "displayMode": "gradient" }
      },
      {
        "id": 12, "title": "Global Stats", "type": "table",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 3 },
        "targets": [
          { "expr": "pgbouncer_databases", "legendFormat": "Databases", "refId": "A", "instant": true },
          { "expr": "pgbouncer_users", "legendFormat": "Users", "refId": "B", "instant": true },
          { "expr": "pgbouncer_pools", "legendFormat": "Pools", "refId": "C", "instant": true },
          { "expr": "pgbouncer_used_clients", "legendFormat": "Used Clients", "refId": "D", "instant": true },
          { "expr": "pgbouncer_free_clients", "legendFormat": "Free Clients", "refId": "E", "instant": true },
          { "expr": "pgbouncer_used_servers", "legendFormat": "Used Servers", "refId": "F", "instant": true },
          { "expr": "pgbouncer_free_servers", "legendFormat": "Free Servers", "refId": "G", "instant": true }
        ],
        "options": { "sortBy": [{ "displayName": "Value", "desc": true }] }
      },
      {
        "id": 20, "title": "Transactions/sec", "type": "timeseries",
        "gridPos": { "h": 7, "w": 12, "x": 0, "y": 11 },
        "targets": [{ "expr": "rate(pgbouncer_total_transactions{database!=\"pgbouncer\"}[1m])", "legendFormat": "{{database}} txn/s", "refId": "A" }],
        "fieldConfig": { "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 },
          "unit": "cps"
        }}
      },
      {
        "id": 21, "title": "Queries/sec", "type": "timeseries",
        "gridPos": { "h": 7, "w": 12, "x": 12, "y": 11 },
        "targets": [{ "expr": "rate(pgbouncer_total_queries{database!=\"pgbouncer\"}[1m])", "legendFormat": "{{database}} q/s", "refId": "A" }],
        "fieldConfig": { "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 },
          "unit": "qps"
        }}
      },
      {
        "id": 30, "title": "Avg Transaction Time", "type": "timeseries",
        "gridPos": { "h": 7, "w": 12, "x": 0, "y": 18 },
        "targets": [{ "expr": "pgbouncer_avg_xact_time_ms{database!=\"pgbouncer\"}", "legendFormat": "{{database}}", "refId": "A" }],
        "fieldConfig": { "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 },
          "unit": "ms"
        }}
      },
      {
        "id": 31, "title": "Avg Query Time", "type": "timeseries",
        "gridPos": { "h": 7, "w": 12, "x": 12, "y": 18 },
        "targets": [{ "expr": "pgbouncer_avg_query_time_ms{database!=\"pgbouncer\"}", "legendFormat": "{{database}}", "refId": "A" }],
        "fieldConfig": { "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 },
          "unit": "ms"
        }}
      },
      {
        "id": 40, "title": "Bandwidth (Bytes In/Out)", "type": "timeseries",
        "gridPos": { "h": 7, "w": 12, "x": 0, "y": 25 },
        "targets": [
          { "expr": "rate(pgbouncer_bytes_received{database!=\"pgbouncer\"}[1m])", "legendFormat": "Received", "refId": "A" },
          { "expr": "rate(pgbouncer_bytes_sent{database!=\"pgbouncer\"}[1m])", "legendFormat": "Sent", "refId": "B" }
        ],
        "fieldConfig": { "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 },
          "unit": "Bps"
        }}
      },
      {
        "id": 41, "title": "Queue Wait Time", "type": "timeseries",
        "gridPos": { "h": 7, "w": 12, "x": 12, "y": 25 },
        "targets": [{ "expr": "pgbouncer_max_wait_seconds{database!=\"pgbouncer\"}", "legendFormat": "{{database}}", "refId": "A" }],
        "fieldConfig": { "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 50 },
          "unit": "s",
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 15 }] }
        }}
      },
      {
        "id": 50, "title": "Top Tables by Rows", "type": "table",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
        "targets": [{ "expr": "pg_table_rows", "instant": true, "legendFormat": "{{table}}", "refId": "A", "format": "table" }],
        "fieldConfig": { "overrides": [
          { "matcher": { "id": "byName", "options": "table" }, "properties": [{ "id": "displayName", "value": "Table" }] },
          { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "Rows" }] }
        ]},
        "options": { "sortBy": [{ "displayName": "Value", "desc": true }] }
      },
      {
        "id": 51, "title": "Server Connections Over Time", "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
        "targets": [
          { "expr": "pgbouncer_server_active{database!=\"pgbouncer\"}", "legendFormat": "Active", "refId": "A" },
          { "expr": "pgbouncer_server_idle{database!=\"pgbouncer\"}", "legendFormat": "Idle", "refId": "B" },
          { "expr": "pgbouncer_server_used{database!=\"pgbouncer\"}", "legendFormat": "Used", "refId": "C" },
          { "expr": "pgbouncer_client_active{database!=\"pgbouncer\"}", "legendFormat": "Client Active", "refId": "D" },
          { "expr": "pgbouncer_client_waiting{database!=\"pgbouncer\"}", "legendFormat": "Client Waiting", "refId": "E" }
        ],
        "fieldConfig": { "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 },
          "unit": "short"
        }}
      },
      {
        "id": 60, "title": "Total Transactions", "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 40 },
        "targets": [{ "expr": "pgbouncer_total_transactions{database!=\"pgbouncer\"}", "refId": "A" }],
        "fieldConfig": { "defaults": { "unit": "short" }}
      },
      {
        "id": 61, "title": "Total Queries", "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 40 },
        "targets": [{ "expr": "pgbouncer_total_queries{database!=\"pgbouncer\"}", "refId": "A" }],
        "fieldConfig": { "defaults": { "unit": "short" }}
      },
      {
        "id": 62, "title": "Total Bytes Received", "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 40 },
        "targets": [{ "expr": "pgbouncer_bytes_received{database!=\"pgbouncer\"}", "refId": "A" }],
        "fieldConfig": { "defaults": { "unit": "decbytes" }}
      },
      {
        "id": 63, "title": "Total Bytes Sent", "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 40 },
        "targets": [{ "expr": "pgbouncer_bytes_sent{database!=\"pgbouncer\"}", "refId": "A" }],
        "fieldConfig": { "defaults": { "unit": "decbytes" }}
      }
    ],
    "schemaVersion": 39
  },
  "overwrite": true
}
