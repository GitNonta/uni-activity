APP_NAME="University Activity System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=th
APP_FALLBACK_LOCALE=th
APP_FAKER_LOCALE=th_TH

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# ── Database (PostgreSQL Production) ──────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=uni_activity_prod
DB_USERNAME=uni_admin
DB_PASSWORD=strong_production_password_here

# ── Cache, Session & Queue (Redis Production) ─────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=strong_redis_password_here

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=your-domain.com
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=redis

# ── High-Performance Engine (Laravel Octane) ──────────────────
OCTANE_SERVER=swoole
OCTANE_HTTPS=true

# ── Real-Time Broadcasting (Laravel Reverb WebSocket) ─────────
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=uni-chat-prod
REVERB_APP_KEY=change_me_to_random_key
REVERB_APP_SECRET=change_me_to_random_secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=https

# Browser WebSocket connection
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=your-domain.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# ── Object Storage (Cloudflare R2 / AWS S3 / MinIO) ───────────
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=your_r2_or_s3_access_key
AWS_SECRET_ACCESS_KEY=your_r2_or_s3_secret_key
AWS_DEFAULT_REGION=auto
AWS_BUCKET=uni-activity-production
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
AWS_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
AWS_URL=https://cdn.your-domain.com
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── AI Service (Python FastAPI) ───────────────────────────────
AI_SERVER_URL=http://127.0.0.1:8001
AI_SERVER_KEY=change_me_to_secure_ai_key

# ── CORS & Security ───────────────────────────────────────────
CORS_ALLOWED_ORIGINS="https://your-domain.com"

VITE_APP_NAME="${APP_NAME}"
