{
  "name": "Database & Proxy Alerts",
  "interval": "1m",
  "rules": [
    {
      "uid": "alert-pg-client-high",
      "title": "PgBouncer Client Utilization High",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "afx0zblxl8n40d",
          "model": {
            "expr": "pgbouncer_client_utilization_percent",
            "legendFormat": "{{database}}",
            "refId": "A"
          }
        },
        {
          "refId": "B",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "__expr__",
          "model": {
            "type": "reduce",
            "reducer": "last",
            "expression": "A",
            "refId": "B"
          }
        },
        {
          "refId": "C",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "__expr__",
          "model": {
            "type": "threshold",
            "expression": "B",
            "conditions": [
              {
                "evaluator": { "type": "gt", "params": [80] },
                "operator": { "type": "and" },
                "query": { "params": ["C"] },
                "reducer": { "type": "last", "params": [] },
                "type": "query"
              }
            ],
            "refId": "C"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "2m",
      "labels": { "severity": "warning", "category": "connection" },
      "annotations": {
        "summary": "PgBouncer client connections at {{ $values.B }}% (threshold: 80%)",
        "description": "Connection pool is running high. May cause new connections to queue."
      }
    },
    {
      "uid": "alert-pg-server-high",
      "title": "PgBouncer Server Utilization High",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "afx0zblxl8n40d",
          "model": {
            "expr": "pgbouncer_server_utilization_percent",
            "legendFormat": "{{database}}",
            "refId": "A"
          }
        },
        {
          "refId": "B",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "__expr__",
          "model": {
            "type": "reduce",
            "reducer": "last",
            "expression": "A",
            "refId": "B"
          }
        },
        {
          "refId": "C",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "__expr__",
          "model": {
            "type": "threshold",
            "expression": "B",
            "conditions": [
              {
                "evaluator": { "type": "gt", "params": [90] },
                "operator": { "type": "and" },
                "query": { "params": ["C"] },
                "reducer": { "type": "last", "params": [] },
                "type": "query"
              }
            ],
            "refId": "C"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "1m",
      "labels": { "severity": "critical", "category": "connection" },
      "annotations": {
        "summary": "PgBouncer server connections at {{ $values.B }}% (threshold: 90%)",
        "description": "Almost all PostgreSQL server connections are in use. Queries may time out."
      }
    },
    {
      "uid": "alert-slow-queries",
      "title": "Slow Database Queries",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "afx0zblxl8n40d",
          "model": {
            "expr": "pgbouncer_avg_query_time_ms{database!=\"pgbouncer\"}",
            "legendFormat": "{{database}}",
            "refId": "A"
          }
        },
        {
          "refId": "B",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "__expr__",
          "model": {
            "type": "reduce",
            "reducer": "last",
            "expression": "A",
            "refId": "B"
          }
        },
        {
          "refId": "C",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "__expr__",
          "model": {
            "type": "threshold",
            "expression": "B",
            "conditions": [
              {
                "evaluator": { "type": "gt", "params": [2000] },
                "operator": { "type": "and" },
                "query": { "params": ["C"] },
                "reducer": { "type": "last", "params": [] },
                "type": "query"
              }
            ],
            "refId": "C"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "3m",
      "labels": { "severity": "warning", "category": "performance" },
      "annotations": {
        "summary": "Avg query time {{ $values.B }}ms (threshold: 2000ms)",
        "description": "Database queries are running slow. Check for missing indexes or locks."
      }
    },
    {
      "uid": "alert-slow-transactions",
      "title": "Slow Database Transactions",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "afx0zblxl8n40d",
          "model": {
            "expr": "pgbouncer_avg_xact_time_ms{database!=\"pgbouncer\"}",
            "legendFormat": "{{database}}",
            "refId": "A"
          }
        },
        {
          "refId": "B",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "__expr__",
          "model": {
            "type": "reduce",
            "reducer": "last",
            "expression": "A",
            "refId": "B"
          }
        },
        {
          "refId": "C",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "__expr__",
          "model": {
            "type": "threshold",
            "expression": "B",
            "conditions": [
              {
                "evaluator": { "type": "gt", "params": [500] },
                "operator": { "type": "and" },
                "query": { "params": ["C"] },
                "reducer": { "type": "last", "params": [] },
                "type": "query"
              }
            ],
            "refId": "C"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "2m",
      "labels": { "severity": "warning", "category": "performance" },
      "annotations": {
        "summary": "Avg transaction time {{ $values.B }}ms (threshold: 500ms)",
        "description": "Transactions are taking too long. Laravel workers may be bottlenecked."
      }
    },
    {
      "uid": "alert-clients-waiting",
      "title": "Clients Waiting in Queue",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "afx0zblxl8n40d",
          "model": {
            "expr": "sum(pgbouncer_client_waiting{database!=\"pgbouncer\"})",
            "legendFormat": "Waiting",
            "refId": "A"
          }
        },
        {
          "refId": "B",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "__expr__",
          "model": {
            "type": "reduce",
            "reducer": "last",
            "expression": "A",
            "refId": "B"
          }
        },
        {
          "refId": "C",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "__expr__",
          "model": {
            "type": "threshold",
            "expression": "B",
            "conditions": [
              {
                "evaluator": { "type": "gt", "params": [5] },
                "operator": { "type": "and" },
                "query": { "params": ["C"] },
                "reducer": { "type": "last", "params": [] },
                "type": "query"
              }
            ],
            "refId": "C"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "1m",
      "labels": { "severity": "critical", "category": "connection" },
      "annotations": {
        "summary": "{{ $values.B }} clients waiting for a connection",
        "description": "Too many clients queued. Requests will time out."
      }
    },
    {
      "uid": "alert-pgbouncer-down",
      "title": "PgBouncer Down",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "afx0zblxl8n40d",
          "model": {
            "expr": "pgbouncer_up",
            "legendFormat": "Status",
            "refId": "A"
          }
        },
        {
          "refId": "B",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "__expr__",
          "model": {
            "type": "reduce",
            "reducer": "last",
            "expression": "A",
            "refId": "B"
          }
        },
        {
          "refId": "C",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "__expr__",
          "model": {
            "type": "threshold",
            "expression": "B",
            "conditions": [
              {
                "evaluator": { "type": "lt", "params": [1] },
                "operator": { "type": "and" },
                "query": { "params": ["C"] },
                "reducer": { "type": "last", "params": [] },
                "type": "query"
              }
            ],
            "refId": "C"
          }
        }
      ],
      "noDataState": "Alerting",
      "execErrState": "Alerting",
      "for": "30s",
      "labels": { "severity": "critical", "category": "health" },
      "annotations": {
        "summary": "PgBouncer exporter is DOWN",
        "description": "Cannot reach PgBouncer metrics. Check if the exporter process is running."
      }
    },
    {
      "uid": "alert-squid-down",
      "title": "Squid Proxy Down",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "afx0zblxl8n40d",
          "model": {
            "expr": "squid_up",
            "legendFormat": "Status",
            "refId": "A"
          }
        },
        {
          "refId": "B",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "__expr__",
          "model": {
            "type": "reduce",
            "reducer": "last",
            "expression": "A",
            "refId": "B"
          }
        },
        {
          "refId": "C",
          "relativeTimeRange": { "from": 300, "to": 0 },
          "datasourceUid": "__expr__",
          "model": {
            "type": "threshold",
            "expression": "B",
            "conditions": [
              {
                "evaluator": { "type": "lt", "params": [1] },
                "operator": { "type": "and" },
                "query": { "params": ["C"] },
                "reducer": { "type": "last", "params": [] },
                "type": "query"
              }
            ],
            "refId": "C"
          }
        }
      ],
      "noDataState": "Alerting",
      "execErrState": "Alerting",
      "for": "30s",
      "labels": { "severity": "critical", "category": "health" },
      "annotations": {
        "summary": "Squid proxy exporter is DOWN",
        "description": "Cannot reach Squid metrics. Check if the exporter process is running."
      }
    }
  ]
}
