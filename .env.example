APP_NAME="University Activity System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=th
APP_FALLBACK_LOCALE=th
APP_FAKER_LOCALE=th_TH

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (PostgreSQL 16) ──────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=uni_activity
DB_USERNAME=root
DB_PASSWORD=root

# ── Cache, Session & Queue (Redis / Dragonfly) ────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis

# ── High-Performance Engine (Laravel Octane) ──────────────────
OCTANE_SERVER=swoole
OCTANE_HTTPS=false

# ── Real-Time Broadcasting (Laravel Reverb WebSocket) ─────────
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=uni-chat
REVERB_APP_KEY=uni-chat-key
REVERB_APP_SECRET=uni-chat-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Browser WebSocket connection
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── File Storage (Local or S3/Cloudflare R2 for Multi-Server) ──
FILESYSTEM_DISK=public
# Set to 's3' when running on 2+ Servers (Cloudflare R2 / MinIO / AWS S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=uni-activity
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
# MinIO:         http://127.0.0.1:9000
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── AI Service (Python FastAPI + InsightFace) ─────────────────
AI_SERVER_URL=http://127.0.0.1:8001
AI_SERVER_KEY=uni-activity-ai-secret-key-2026

# ── CORS & Security ───────────────────────────────────────────
CORS_ALLOWED_ORIGINS="http://127.0.0.1:8080,http://localhost:8080,http://192.168.1.222:8080,http://127.0.0.1:8000,http://localhost:8000"

VITE_APP_NAME="${APP_NAME}"
