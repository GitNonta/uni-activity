# =================================================================
#  University Activity Management & Verification System
#  ไฟล์ตัวอย่าง environment — copy ไปเป็น .env แล้วแก้ค่าให้ตรงเครื่อง
#    cp .env.example .env && php artisan key:generate
#  ห้าม commit ไฟล์ .env จริง (มีใน .gitignore แล้ว)
# =================================================================

# ── Application ──────────────────────────────────────────────────
APP_NAME="University Activity System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=th
APP_FALLBACK_LOCALE=th
APP_FAKER_LOCALE=th_TH

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
# ใช้เมื่อ rotate APP_KEY (คั่นด้วย comma)
APP_PREVIOUS_KEYS=

BCRYPT_ROUNDS=12

# ── Logging ──────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (PostgreSQL 16) ─────────────────────────────────────
# เริ่มเร็วด้วย sqlite ได้: DB_CONNECTION=sqlite
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=uni_activity
DB_USERNAME=postgres
DB_PASSWORD=
# DSN เต็ม (ถ้าใช้แทนค่า host/port ด้านบน)
DB_URL=
DB_SSLMODE=prefer

# ── Cache / Session (Redis) ──────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# ── Queue (Valkey/Redis แยก instance — port 6380) ────────────────
QUEUE_CONNECTION=redis
REDIS_QUEUE_HOST=127.0.0.1
REDIS_QUEUE_PORT=6380
REDIS_QUEUE_USERNAME=null
REDIS_QUEUE_PASSWORD=null
REDIS_QUEUE_DB=0
REDIS_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids
# prefix ของ key ใน Redis (แยก namespace ระหว่าง environment)
REDIS_PREFIX=uni-activity_
CACHE_PREFIX=uni-activity_cache_

# ── High-Performance Engine (Laravel Octane) ─────────────────────
# swoole (ค่าเริ่มต้นของโปรเจกต์) หรือ frankenphp ก็ได้
OCTANE_SERVER=swoole
OCTANE_HTTPS=false

# ── Real-Time Broadcasting (Laravel Reverb WebSocket) ────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=uni-chat
REVERB_APP_KEY=uni-chat-key
REVERB_APP_SECRET=uni-chat-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8082
REVERB_INTERNAL_HOST=127.0.0.1
REVERB_INTERNAL_PORT=8082
REVERB_SCALING_ENABLED=false

# Client (Vite) ต้องชี้ไปที่ host/port ที่เบราว์เซอร์เข้าถึงได้
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── File Storage (local หรือ S3-compatible: R2 / MinIO) ─────────
FILESYSTEM_DISK=public
# URL สาธารณะของ storage (ถ้าเสิร์ฟผ่าน CDN/โดเมนแยก)
PUBLIC_STORAGE_URL=
# ตั้งเป็น 's3' และกรอกค่าด้านล่างเมื่อรันหลายเครื่อง
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=uni-activity
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
# MinIO:         http://127.0.0.1:9000
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Mail ─────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# ผู้ให้บริการอีเมล (ถ้าใช้)
RESEND_API_KEY=
POSTMARK_API_KEY=

# ── AI Face Verification Service (Python FastAPI) ───────────────
AI_SERVER_URL=http://127.0.0.1:8001
# หลายโหนด: คั่นด้วย comma (load balancer ฝั่ง Laravel)
AI_SERVERS=
AI_SERVER_KEY=change-me-ai-shared-secret
# คีย์เดิมที่ยังรองรับ (fallback ของ AI_SERVER_KEY)
AI_SERVICE_API_KEY=
AI_SERVER_TIMEOUT=6
AI_SERVER_RETRIES=2
AI_CIRCUIT_BREAKER_THRESHOLD=3
AI_CIRCUIT_BREAKER_COOLDOWN=30

# ── LINE Official Account / LINE Login ──────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_CALLBACK_URL=
LINE_REDIRECT_BASE_URL=
# legacy: LINE Notify (ปิดบริการแล้ว — เก็บไว้เพื่อความเข้ากันได้)
LINE_NOTIFY_TOKEN=

# ── SSO (OAuth2 / OIDC — generic provider) ──────────────────────
SSO_ENABLED=false
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
SSO_DISCOVERY_URL=
SSO_SCOPES="openid email profile"

# ── Payments (PromptPay) ────────────────────────────────────────
PROMPTPAY_FALLBACK_ID=

# ── Security & Networking ───────────────────────────────────────
CORS_ALLOWED_ORIGINS="http://localhost:8000,http://127.0.0.1:8080"
SANCTUM_STATEFUL_DOMAINS="localhost,localhost:8000,127.0.0.1"
# รายการ IP ที่อนุญาตเข้า admin (คั่นด้วย comma, ว่าง = ไม่จำกัด)
ADMIN_IP_WHITELIST=
# user id ที่ข้ามการยืนยัน OTP (สำหรับ debug เท่านั้น — ว่างใน production)
AUTH_OTP_BYPASS_IDS=
# ระบุเมื่ออยู่หลัง reverse proxy (เช่น Cloudflare)
FORWARD_PROXY=
# ตัวระบุโหนดใน cluster (แสดงใน monitor/health)
NODE_ID=

# ── Backups (database + storage) ────────────────────────────────
BACKUP_DISK=local
BACKUP_RETENTION_DAYS=14
BACKUP_KEEP_MINIMUM_COUNT=5
BACKUP_NOTIFY_LINE=true
BACKUP_NOTIFY_MAIL=false

# ── Optional: Queue dashboard / legacy socket server ────────────
HORIZON_PATH=horizon
HORIZON_DOMAIN=
SOCKET_SERVER_URL=
SOCKET_PUBLIC_URL=
SOCKET_SECRET=
