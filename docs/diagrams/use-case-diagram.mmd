    classDef key fill:#f0fdf4,stroke:#16a34a,color:#14532d
    classDef auth fill:#fef9c3,stroke:#eab308,color:#713f12

    subgraph SYS["🏛️ Uni-Activity System"]
        direction TB

        subgraph PUB["🌐 Public"]
            UC1((ดูรายการ<br/>กิจกรรม)):::uc
            UC2((ดูรายละเอียด<br/>กิจกรรม · ประกาศ · งาน)):::uc
            UC3((ดูแผนที่<br/>/map)):::uc
            UC4((ตรวจสอบใบรับรอง<br/>ออนไลน์)):::uc
        end

        subgraph ACC["🔐 บัญชีผู้ใช้"]
            UC5((เข้าสู่ระบบ<br/>Login + OTP)):::auth
            UC6((สมัครบัญชี<br/>Register)):::auth
            UC7((ลืมรหัสผ่าน<br/>Reset ผ่าน Email)):::auth
            UC8((จัดการโปรไฟล์<br/>รูป · ชื่อ EN)):::uc
            UC9((เชื่อม / ตัดการเชื่อม<br/>LINE Notify)):::uc
        end

        subgraph ACT["📅 กิจกรรม & ลงทะเบียน"]
            UC10((ลงทะเบียน<br/>กิจกรรม)):::key
            UC11((ยกเลิก<br/>การลงทะเบียน)):::uc
            UC12((ดูกิจกรรมของฉัน<br/>ปฏิทิน · ประวัติ)):::uc
            UC13((ประเมินกิจกรรม<br/>Feedback)):::uc
        end

        subgraph CHECK["✅ เช็คอิน"]
            UC14((สแกน QR<br/>เช็คอิน)):::key
            UC15((ยืนยันใบหน้า<br/>Face + Liveness)):::key
            UC16((Walk-in Check-in<br/>หน้างาน)):::uc
            UC17((เช็คอินแทน<br/>Manual)):::uc
            UC18((Monitor เช็คอิน<br/>Real-time)):::uc
            UC19((Review Selfie<br/>ที่ไม่ผ่าน Auto)):::uc
        end

        subgraph RPT["📊 สรุป & เอกสาร"]
            UC20((สรุปชั่วโมง<br/>+ PDF Transcript)):::uc
            UC21((เคลมใบรับรอง<br/>Certificate)):::key
            UC22((Export Excel<br/>รายงานทั้งหมด)):::uc
        end

        subgraph CHAT["💬 Realtime Chat"]
            UC23((ส่ง/แก้ไข/ลบข้อความ<br/>แชทกับเจ้าหน้าที่)):::key
            UC24((Inbox ตอบนักศึกษา<br/>Read receipt live)):::uc
        end

        subgraph JOB["💼 ประกาศรับสมัครงาน"]
            UC25((สมัครงาน<br/>Apply + Comment)):::uc
            UC26((จัดการประกาศ<br/>จัดการผู้สมัคร)):::uc
        end

        subgraph BACK["🖥️ หลังบ้าน (Admin)"]
            UC27((จัดการกิจกรรม<br/>CRUD · Clone · QR)):::uc
            UC28((อนุมัติ/ปฏิเสธ<br/>Quick Approve)):::key
            UC29((Import นักศึกษา<br/>Excel Bulk)):::uc
            UC30((จัดการหมวดหมู่<br/>เกณฑ์ชั่วโมง)):::uc
            UC31((Audit Log · Security Log<br/>Review Multi-account)):::uc
            UC32((Backup · Settings<br/>API Keys)):::uc
            UC33((Cluster Monitor<br/>Failed Jobs Retry)):::uc
        end
    end

