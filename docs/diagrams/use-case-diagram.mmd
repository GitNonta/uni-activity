    GUEST(["👤 ผู้เยี่ยมชม<br/>(Guest)"]):::actor
    STU(["🧑‍🎓 นักศึกษา<br/>(Student)"]):::actor
    STF(["👩‍💼 เจ้าหน้าที่<br/>(Staff)"]):::actor
    ADM(["🛡️ ผู้ดูแลระบบ<br/>(Admin/Super)"]):::actor
    AI(["🤖 AI Microservice"]):::ext
    LINE(["💬 LINE API"]):::ext

    classDef actor fill:#dbeafe,stroke:#2563eb,color:#0f172a,stroke-width:1.5px
