# =================================================================
#  University Activity Management & Verification System
#  .gitignore — track เฉพาะ source code, config ตัวอย่าง และ asset ที่ใช้จริง
# =================================================================

# -----------------------------------------------------------------
# 1. Environment & Secrets (ห้าม commit ของจริง)
# -----------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.crt
*.pfx
*.p12
id_rsa*
auth.json
*.secret

# -----------------------------------------------------------------
# 2. Dependencies & Build Tooling
# -----------------------------------------------------------------
/vendor/
/node_modules/
/public/hot/
pip_wheels/
.venv/
venv/

# -----------------------------------------------------------------
# 3. Framework Runtime State
# -----------------------------------------------------------------
/public/storage
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/app/private/*
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore

# -----------------------------------------------------------------
# 4. User Uploads & Heavy Binaries
#    (รูป/วิดีโอใน public/, docs/, svg/ ยัง track ได้ — กันเฉพาะ uploads)
# -----------------------------------------------------------------
/public/uploads/
/face_cpp/testdata/
/face_dx/testdata/
*.onnx
*.pt
*.pth
*.bin
*.dll
*.so
*.exe
*.o
*.obj
*.zip
*.rar
*.7z
*.tar.gz
*.pdf
*.sql
*.sql.bak
*.xlsx
*.xls
*.csv
database_dumps/
/face_dx/build/
/face_cpp/build/

# -----------------------------------------------------------------
# 5. Logs & Generated Dumps
# -----------------------------------------------------------------
*.log
/logs/
/watchdog_logs/
/face_dx/reports/celeba_*.json
lang/.extracted*.json

# -----------------------------------------------------------------
# 6. Python
# -----------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# -----------------------------------------------------------------
# 7. IDE, OS & Local Tooling
# -----------------------------------------------------------------
.DS_Store
Thumbs.db
/.idea/
/.vscode/
/.claude/
/.agents/
scratch/
*.swp
*~
.rr.yaml
frankenphp
.phpunit.result.cache
/.phpunit.cache/
/coverage/
