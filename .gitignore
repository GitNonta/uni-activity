# =================================================================
# LARAVEL PRODUCTION GITIGNORE
# Directs Git to ONLY track production source code & configuration
# =================================================================

# -----------------------------------------------------------------
# 1. Environment & Sensitive Credentials (DO NOT COMMIT)
# -----------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.key
*.pem
*.crt
*.pfx
*.p12
id_rsa*
auth.json

# -----------------------------------------------------------------
# 2. Database Dumps & Personal Data (DO NOT COMMIT)
# -----------------------------------------------------------------
*.sql
*.sql.bak
database_dumps/
*.xlsx
*.csv
*.xls
*.pdf

# -----------------------------------------------------------------
# 3. User Uploads, Media & Binary Model Weights (DO NOT COMMIT)
# -----------------------------------------------------------------
/public/storage
/storage/app/public/
/storage/logs/
/storage/framework/cache/
/storage/framework/sessions/
/storage/framework/views/
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.mp4
*.zip
*.rar
*.7z
*.tar.gz
*.pt
*.pth
*.onnx
*.bin

# Allow architectural SVG diagrams or logos
!/public/*.svg
!/public/favicon.ico

# -----------------------------------------------------------------
# 4. Dependency Directories & Compiled Assets
# -----------------------------------------------------------------
/vendor/
/node_modules/
# /public/build/
/public/hot/
monitor-ui/node_modules/
monitor-ui/dist/
pip_wheels/
__pycache__/
**/__pycache__/
*.pyc

# -----------------------------------------------------------------
# 5. Non-Production & Hardware Tools (DO NOT COMMIT)
# -----------------------------------------------------------------
/edl/
/edl_extracted_data/
/scripts/
!/scripts/*.sh
/watchdog_logs/
/socketserver/
py/test_*.py
*.log

# -----------------------------------------------------------------
# 6. IDE, OS & Local AI Configs
# -----------------------------------------------------------------
.DS_Store
Thumbs.db
/.vscode/
/.idea/
/.claud/
.phpunit.result.cache
/.phpunit.cache/